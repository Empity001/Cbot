# Copia este archivo a .env (o cárgalo como variables en tu hosting) y rellénalo.
# No subas nunca el archivo .env real ni estos valores a GitHub.

# Discord (Developer Portal -> tu aplicación)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Supabase (Project Settings -> API). La clave secreta / service_role es solo para el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web pública, sin barra final
SITE_URL=https://empity001.github.io/Crpg/

# Opcionales
GUIDE_JOB_POLL_MS=15000
GUIDE_JOB_MAX_ATTEMPTS=5
BOT_ALERT_CHANNEL_ID=
BOT_ALERT_COOLDOWN_MS=21600000
